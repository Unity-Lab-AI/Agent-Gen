{
  "name": "agent-gen",
  "productName": "Agent Gen",
  "version": "0.3.0",
  "private": true,
  "description": "Unity, live. One window: her face, her voice, her ears, her hands. Opens everything, closes everything.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable",
    "dist:installer": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.unityailab.agentgen",
    "productName": "Agent Gen",
    "directories": { "output": "../dist" },
    "files": ["main.js", "preload.js", "supervisor.js", "icon.png"],
    "extraResources": [
      { "from": "../hub", "to": "hub", "filter": ["**/*", "!node_modules/.cache/**"] },
      { "from": "../ui", "to": "ui" },
      { "from": "../sidecars", "to": "sidecars", "filter": ["**/*", "!**/__pycache__/**"] },
      { "from": "../assets", "to": "assets" },
      { "from": "../scripts", "to": "scripts" }
    ],
    "win": { "target": ["portable"], "icon": "icon.png" },
    "portable": { "artifactName": "AgentGen.exe" }
  }
}
